# Copy this file to .env and fill in your own values. Never commit .env.

# LLM matching (pipeline/match_comparables.py)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-endpoint.example.com
LLM_MODEL=gpt-4o
LLM_API_VERSION=2024-10-21

# Finnhub (pipeline/fetch_finnhub.py)
FINNHUB_KEY=your-finnhub-key

# Optional, not read by any script yet
# TWELVE_DATA_KEY=your-twelve-data-key

# Sentiment script (pipeline/analyze_sentiment.py) reads these names instead.
# It uses the first one that is set in each group.
# ASTRA_API_KEY=your-api-key            # or OPENAI_API_KEY, or GPT_API_KEY
# OPENAI_BASE_URL=https://your-endpoint.example.com   # or OPENAI_ENDPOINT, or ASTRA_BASE_URL
# AZURE_OPENAI_API_VERSION=2024-10-21
